# Development only. Never reuse these values outside local development.
# Superuser used for migrations and tests (bypasses RLS by design).
DATABASE_ADMIN_URL=postgres://kidos_admin:kidos_dev@localhost:5433/kidos
# Restricted application role (cannot bypass RLS, owns no tables).
DATABASE_APP_URL=postgres://kidos_app_login:kidos_app_dev@localhost:5433/kidos
# API settings. Generate a real key with: openssl rand -base64 32   (this one is for local development only)
MFA_ENCRYPTION_KEY=a2lkb3MtZGV2LW9ubHkta2V5LW5vdC1mb3ItcHJvZCE=
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Set to true only when running behind a trusted reverse proxy.
TRUST_PROXY=false
# Used by tests to create and drop throwaway databases.
TEST_DATABASE_ADMIN_URL=postgres://kidos_admin:kidos_dev@localhost:5433/postgres

# Optional: where the operations desk is alerted about things only a family or vendor can trigger (a new request, a quote).
# Leave empty to turn these alerts off. Other alerts go straight to the people concerned.
OPS_ALERT_EMAIL=

# Web build settings (read when the web app is built). The team's contact details, shown on the public /safety page so that
# someone who cannot sign in can still reach a person. Leave empty and the page shows no contact section; set both before launch.
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_SUPPORT_PHONE=
# Pictures: photos are files in apps/web/public/photos (see docs/PHOTOS.md). Set to "none" to show nothing, instead of the drawn stand-ins, where a photo is missing.
# NEXT_PUBLIC_ARTWORK_FALLBACK=drawings
